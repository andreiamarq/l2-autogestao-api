            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aluno.teste@exemplo.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Com EXIBIR_TOKEN_RESET=true o token vem no campo tokenRecuperacao e também é impresso no console da API."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
