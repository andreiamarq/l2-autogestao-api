# Copie este arquivo para .env (cp .env.example .env) e ajuste se necessário.
# O arquivo .env NÃO deve ser enviado ao GitHub.

# Banco SQLite (o caminho é relativo à pasta prisma/)
DATABASE_URL="file:./dev.db"

# Porta da API
PORT=3000

# Chave usada para assinar o token JWT (troque por um valor longo e aleatório)
JWT_SECRET="troque-por-uma-chave-secreta-longa"
JWT_EXPIRES_IN="2h"

# Recuperação de senha
# Validade do token de recuperação, em minutos
RESET_TOKEN_MINUTES=15
# true = devolve o token na resposta de /auth/forgot-password e o imprime no console
# (útil para testes, já que a API não envia e-mail de verdade)
EXIBIR_TOKEN_RESET=true
